; ============================================================================
; stefly-stick-remote.inf
;
; Windows-INF-Datei fuer den SteFly Stick Remote (pid.codes VID 0x1209, PID 0x8500).
; Verwendet den in Windows 10/11 eingebauten Treiber 'usbser.sys' und liefert
; nur den Friendly-Name fuer den Geraete-Manager.
;
; Installation: siehe README.md im selben Ordner.
;
; (c) 2026 SteFly.aero - Verteilung unter MIT-Lizenz analog zur Firmware.
; ============================================================================

[Version]
Signature   = "$Windows NT$"
Class       = Ports
ClassGuid   = {4D36E978-E325-11CE-BFC1-08002BE10318}
Provider    = %ManufacturerName%
DriverVer   = 05/27/2026,1.0.0.0
CatalogFile = stefly-stick-remote.cat

[Manufacturer]
%ManufacturerName% = SteFlyDevices, NTamd64, NTx86, NTarm64

; ----- 64-bit AMD/Intel ------------------------------------------------------
[SteFlyDevices.NTamd64]
%StickRemote_DeviceName% = SteFlyInstall, USB\VID_1209&PID_8500&MI_00

; ----- 32-bit x86 (Legacy, fuer aeltere Windows-Installationen) -------------
[SteFlyDevices.NTx86]
%StickRemote_DeviceName% = SteFlyInstall, USB\VID_1209&PID_8500&MI_00

; ----- ARM64 (Surface Pro X, Snapdragon-Notebooks, etc.) -------------------
[SteFlyDevices.NTarm64]
%StickRemote_DeviceName% = SteFlyInstall, USB\VID_1209&PID_8500&MI_00

; ----- Installations-Abschnitt: bindet den OS-Standard-usbser.sys ein ------
[SteFlyInstall]
Include = usbser.inf
Needs   = USBSER.NT

[SteFlyInstall.Services]
Include = usbser.inf
Needs   = USBSER.NT.Services

[SteFlyInstall.HW]
Include = usbser.inf
Needs   = USBSER.NT.HW

; ============================================================================
; Strings - hier den Anzeigenamen anpassen, falls noetig.
; ============================================================================
[Strings]
ManufacturerName        = "SteFly.aero"
StickRemote_DeviceName  = "SteFly Stick Remote"
